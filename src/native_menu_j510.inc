volatile uint8_t g_j510HoldPortrait = 0;

void __fastcall J510PortraitRender(void* self, void*, const void* position, bool flag) {
    const uint8_t saved = g_j510HoldPortrait;
    g_j510HoldPortrait = g_luaFrameIntermediate ? 1 : 0;
    using Render = void(__thiscall*)(void*, const void*, bool);
    __try { reinterpret_cast<Render>(Addr(0x9611B0))(self, position, flag); }
    __finally { g_j510HoldPortrait = saved; }
}

struct J510Patch {
    uintptr_t site;
    const uint8_t* oldBytes;
    const uint8_t* newBytes;
    size_t size;
};

template <size_t Count>
bool CommitJ510Patches(const J510Patch (&sites)[Count]) {
    DWORD previous[Count]{};
    for (const auto& patch : sites)
        if (!Expect(patch.site, patch.oldBytes, patch.size, "J510 installation preflight")) return false;
    size_t writable = 0;
    for (; writable < Count; ++writable) {
        const auto& patch = sites[writable];
        if (!VirtualProtect(Addr(patch.site), patch.size, PAGE_EXECUTE_READWRITE, &previous[writable])) break;
    }
    bool okay = writable == Count;
    if (okay) {
        for (const auto& patch : sites) std::memcpy(Addr(patch.site), patch.newBytes, patch.size);
        for (const auto& patch : sites)
            if (!FlushInstructionCache(GetCurrentProcess(), Addr(patch.site), patch.size)) okay = false;
        if (!okay) {
            for (const auto& patch : sites) std::memcpy(Addr(patch.site), patch.oldBytes, patch.size);
            for (const auto& patch : sites) FlushInstructionCache(GetCurrentProcess(), Addr(patch.site), patch.size);
        }
    }
    while (writable > 0) {
        --writable;
        DWORD unused = 0;
        const auto& patch = sites[writable];
        VirtualProtect(Addr(patch.site), patch.size, previous[writable], &unused);
    }
    return okay;
}

bool ValidateJ510MenuLayout() {
    const uint8_t owner[]{0x8d,0x8e,0x34,0x15,0x00,0x00,0xe8,0xac,0xe4,0xfb,0xff};
    const uint8_t viewport[]{0xf3,0x0f,0x10,0x40,0x44,0xf3,0x0f,0x10,0x48,0x48};
    const uint8_t count[]{0x8b,0x87,0x18,0x0b,0x00,0x00};
    const uint8_t positions[]{0x8b,0x93,0x38,0x0c,0x00,0x00};
    const uint8_t scales[]{0x8b,0x83,0x44,0x0c,0x00,0x00};
    const uint8_t roster[]{0x8b,0x87,0xb4,0x0d,0x00,0x00};
    return Expect(0x9A1629, owner, sizeof owner, "J510 character menu render owner") &&
           Expect(0x9A1575, viewport, sizeof viewport, "J510 menu viewport") &&
           Expect(0x96343F, count, sizeof count, "J510 carousel entries") &&
           Expect(0x961576, positions, sizeof positions, "J510 carousel positions") &&
           Expect(0x961591, scales, sizeof scales, "J510 carousel scales") &&
           Expect(0x963460, roster, sizeof roster, "J510 carousel roster page");
}

void TickJ510MenuScalars() {
    using namespace highfps::native_render_clock;
    const auto context = MenuPresentationContext();
    if (!highfps::menu_presentation::Active(context)) return;
    const uintptr_t character = context.menu + 0x1534;
    const int state = *reinterpret_cast<const int*>(character + 8);
    auto& characterFade = *reinterpret_cast<float*>(character + 0x34);
    auto& vignetteFade = *reinterpret_cast<float*>(context.menu + 0x34);
    characterFade = CharacterTick(characterFade, state);
    vignetteFade = VignetteTick(vignetteFade, state);
}
